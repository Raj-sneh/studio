
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MASTER ARCHITECT SECURITY PROTOCOL
     * Implements absolute authority for the primary developer and strict ownership for users.
     */

    // --- GLOBAL HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      // Grants absolute authority to the primary developer email address
      return isSignedIn() && request.auth.token.email == 'snehkumarverma2011@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER ARCHITECT OVERRIDE ---
    // This allows the primary developer to manage any document in any collection without restriction.
    // It is positioned at the top to act as an override.
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      // Users can only read/edit their own profiles (credits, etc.)
      allow get, update: if isOwner(userId);
      // New users can create their initial profile
      allow create: if isSignedIn();

      // Access to sub-collections like 'history', 'clonedVoices', etc.
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- PUBLIC & SHARED COLLECTIONS ---
    match /lessons/{lessonId} {
      allow read: if true; // Public access for interactive tutorials
    }

    match /admin_notices/{noticeId} {
      // Essential for the message system: Authenticated users can list/read broadcasts
      allow read: if isSignedIn();
    }

    match /global_settings/{docId} {
      // Allows the app to check system-wide configuration
      allow read: if isSignedIn();
    }

    // --- PROTECTED ADMIN COLLECTIONS ---
    match /audit_logs/{logId} {
      // Only the Master Admin can see the log of credit injections and activity
      allow read, write: if isMasterAdmin();
    }

    match /reports/{reportId} {
      // Any authenticated user can submit a report, but only the Master Admin can review them
      allow create: if isSignedIn();
      allow read, delete: if isMasterAdmin();
    }
  }
}
