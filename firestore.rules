rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MASTER ARCHITECT SECURITY PROTOCOL v6.0
     * Authority: 'snehkumarverma2011@gmail.com'
     * Status: Deployment Synchronized
     */

    // --- GLOBAL HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      // Grants absolute authority to your specific email address.
      // We check for email existence and force lowercase comparison for robustness.
      return isSignedIn() && 
             "email" in request.auth.token && 
             request.auth.token.email.lower() == 'snehkumarverma2011@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER ARCHITECT OVERRIDE ---
    // This allows you to manage any document in any collection without restriction.
    // Placed at the top for absolute priority in evaluation.
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      allow create: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- PUBLIC & SHARED COLLECTIONS ---
    match /lessons/{lessonId} {
      allow read: if true; // Public access for tutorials
    }

    match /admin_notices/{noticeId} {
      // Essential for the message system: System broadcasts must be publicly readable
      // to prevent "Early Query" permission errors during session initialization.
      allow read, list: if true;
    }

    match /global_settings/{docId} {
      // Allows the app to check system parameters
      allow read: if isSignedIn();
    }

    // --- PROTECTED ADMIN COLLECTIONS ---
    match /audit_logs/{logId} {
      allow read, write: if isMasterAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, delete: if isMasterAdmin();
    }
  }
}