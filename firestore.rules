
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MASTER ARCHITECT SECURITY PROTOCOL v3.0
     * Authority: 'snehkumarverma2011@gmail.com'
     * Last Sync: 2024-05-20
     */

    // --- GLOBAL HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'snehkumarverma2011@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER ARCHITECT OVERRIDE ---
    // Grants absolute authority to the primary developer across all collections.
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      allow create: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- PUBLIC & SHARED COLLECTIONS ---
    match /lessons/{lessonId} {
      allow read: if true;
    }

    match /admin_notices/{noticeId} {
      // Explicitly allow reading notices for all verified accounts to support the broadcast system.
      allow read: if isSignedIn();
    }

    match /global_settings/{docId} {
      allow read: if isSignedIn();
    }

    // --- PROTECTED ADMIN COLLECTIONS ---
    match /audit_logs/{logId} {
      allow read, write: if isMasterAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, delete: if isMasterAdmin();
    }
  }
}
