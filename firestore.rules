
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MASTER ARCHITECT SECURITY PROTOCOL
     * Absolute authority for 'snehkumarverma2011@gmail.com'.
     * Updated: Protocol v2.1 (Explicit List Authorization)
     */

    // --- GLOBAL HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'snehkumarverma2011@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER ARCHITECT OVERRIDE ---
    // Grants absolute authority to the primary developer across all collections.
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      allow create: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- PUBLIC & SHARED COLLECTIONS ---
    match /lessons/{lessonId} {
      allow read: if true;
    }

    match /admin_notices/{noticeId} {
      // Explicitly allow both individual reads and collection listing for verified users.
      allow read, list: if isSignedIn();
    }

    match /global_settings/{docId} {
      allow read: if isSignedIn();
    }

    // --- PROTECTED ADMIN COLLECTIONS ---
    match /audit_logs/{logId} {
      allow read, write: if isMasterAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, delete: if isMasterAdmin();
    }
  }
}
