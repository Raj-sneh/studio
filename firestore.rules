rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * MASTER ARCHITECT SECURITY PROTOCOL v5.0
     * Authority: 'snehkumarverma2011@gmail.com'
     * Last Sync: 2024-05-22 (Deployment Active)
     */

    // --- GLOBAL HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      // Grants absolute authority to your specific email address.
      // We check for email existence to prevent errors on non-email providers.
      return isSignedIn() && 
             "email" in request.auth.token && 
             request.auth.token.email.lower() == 'snehkumarverma2011@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- MASTER ARCHITECT OVERRIDE ---
    // Grants absolute authority across the entire database for the primary developer.
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      allow create: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- PUBLIC & SHARED COLLECTIONS ---
    match /lessons/{lessonId} {
      allow read: if true;
    }

    match /admin_notices/{noticeId} {
      // System broadcasts must be reachable by everyone to prevent UI synchronization errors.
      allow read, list: if true;
    }

    match /global_settings/{docId} {
      allow read: if isSignedIn();
    }

    // --- PROTECTED ADMIN COLLECTIONS ---
    match /audit_logs/{logId} {
      allow read, write: if isMasterAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, delete: if isMasterAdmin();
    }
  }
}