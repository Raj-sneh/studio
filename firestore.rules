rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS FOR RBAC ---
    function hasRole(role) {
      return request.auth != null && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      // MASTER ARCHITECT PROTOCOL: Absolute priority for snehkumarverma2011@gmail.com
      return (request.auth != null && request.auth.token.email == 'snehkumarverma2011@gmail.com') || 
             hasRole('SUPER_ADMIN');
    }

    function isModerator() {
      return hasRole('MODERATOR');
    }

    function isSupport() {
      return hasRole('SUPPORT');
    }

    // --- 1. MASTER ARCHITECT OVERRIDE ---
    // This ensures the developer always has unrestricted access.
    match /{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }

    // --- 2. USER PROFILE RULES ---
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId || isSuperAdmin() || isSupport();
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow update: if request.auth != null && request.auth.uid == userId || isSuperAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId || isSuperAdmin();
      }
    }

    // --- 3. ADMIN NOTICES (PUBLIC BROADCAST) ---
    // Readable by everyone to ensure system-wide message delivery.
    match /admin_notices/{noticeId} {
      // 🛡️ SYNC FIX: Explicitly allow list/read for all users to prevent UI crashes.
      allow read, list: if true; 
      allow write: if isSuperAdmin();
    }

    // --- 4. GLOBAL SETTINGS (SYSTEM CONFIG) ---
    match /global_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- 5. SYSTEM LOGS ---
    match /audit_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // --- 6. PUBLIC CONTENT ---
    match /lessons/{lessonId} {
      allow read: if true; 
    }

    // DEPLOYMENT TRIGGER: 2024-05-20-T12-00-Z
  }
}